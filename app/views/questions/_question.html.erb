<div class="mb-sm">
  <%= question.body %>
</div>

<div class="text-sm question-footer">
  <div class="text-grey">
    <%= l(question.created_at, format: :short) %>
  </div>

  <div>
    <p class="mt"><%= link_to "Edit the question", edit_question_path(question) %></p>
    <%= button_to "Delete the question", question_path(question), method: :delete %>
  </div>
</div>
